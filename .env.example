# Copy to .env (gitignored). D-03: the public origin lives only here, never in code.
APP_ORIGIN=https://duet.brkn.me
COOKIE_SECURE=true
LOG_LEVEL=info

# Cloudflare TURN (D-16, INFR-03). CF_TURN_KEY_ID and CF_TURN_KEY_API_TOKEN are written by
# `bash deploy/cloudflare/turn-key.sh` (Cloudflare API only). Never commit their values.
# Without them the app still runs, and POST /api/rtc/ice-servers answers 503 turn_unconfigured.
# CF_TURN_KEY_ID=
# CF_TURN_KEY_API_TOKEN=
# Lifetime of each minted TURN credential in seconds (60..172800).
# TURN_CREDENTIAL_TTL_SECONDS=86400

# Web Push VAPID keypair (NOTF-01). Written once by `bash deploy/vapid-keys.sh`; never rotate it,
# because a new pair invalidates every phone's push subscription. Never commit the values.
# Without the pair the app still runs, and GET /api/push/vapid-public-key answers 503 push_unconfigured.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for the push services: https: URL or mailto:. Defaults to APP_ORIGIN when that is https.
# VAPID_SUBJECT=https://duet.brkn.me
