# Copy to .env (gitignored). D-03: the public origin lives only here, never in code.
APP_ORIGIN=https://duet.brkn.me
COOKIE_SECURE=true
LOG_LEVEL=info

# Cloudflare TURN (D-16, INFR-03). CF_TURN_KEY_ID and CF_TURN_KEY_API_TOKEN are written by
# `bash deploy/cloudflare/turn-key.sh` (Cloudflare API only). Never commit their values.
# Without them the app still runs, and POST /api/rtc/ice-servers answers 503 turn_unconfigured.
# CF_TURN_KEY_ID=
# CF_TURN_KEY_API_TOKEN=
# Lifetime of each minted TURN credential in seconds (60..172800).
# TURN_CREDENTIAL_TTL_SECONDS=86400
